# =============================================================================
# Cadê Meu Dinheiro? — Environment (Fase 01: Fundação)
# Copie este arquivo para ".env" e preencha os valores locais.
# Nunca versionar o arquivo ".env" real.
# =============================================================================

# --- App -----------------------------------------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001
NODE_ENV=development

# --- Database (PostgreSQL — fonte primária de verdade) --------------------
POSTGRES_USER=cade_meu_dinheiro
POSTGRES_PASSWORD=cade_meu_dinheiro
POSTGRES_DB=cade_meu_dinheiro
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cade_meu_dinheiro:cade_meu_dinheiro@localhost:5432/cade_meu_dinheiro?schema=public

# --- Redis (filas, cache, locks, rate limiting — nunca fonte de verdade) --
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object Storage (S3-compatible — documentos financeiros) --------------
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=cade-meu-dinheiro-documents
STORAGE_ACCESS_KEY_ID=cade_meu_dinheiro
STORAGE_SECRET_ACCESS_KEY=cade_meu_dinheiro_secret
STORAGE_USE_SSL=false

# --- Auth ------------------------------------------------------------------
AUTH_JWT_SECRET=
AUTH_JWT_EXPIRES_IN=15m
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d

# --- AI Provider (documentado apenas — integração fora do escopo da Fase 01) ---
AI_PROVIDER_NAME=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# --- OCR Provider (documentado apenas — integração fora do escopo da Fase 01) ---
OCR_PROVIDER_NAME=
OCR_PROVIDER_API_KEY=
